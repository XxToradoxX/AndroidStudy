    <string name="intro_image_desc">二极管电路符号示意图</string>
    <string name="intro_heading">二极管 Diode</string>
    <string name="intro_subtitle">PN 结 · 单向导电 · 两端器件</string>
    <string name="section_intro">基本介绍</string>
    <string name="intro_body">二极管是由 P 型半导体与 N 型半导体结合形成的 PN 结构成的两端器件，具有单向导电性：阳极电位高于阴极时导通，反之截止。它是整流、检波、限幅、稳压与开关电路中最基础的分立器件。</string>
    <string name="section_features">核心特性</string>
    <string name="feature_one_way">单向导电性：正向导通、反向截止，是整流与检波的基础。</string>
    <string name="feature_nonlinear">非线性伏安特性：正向电流随电压近似指数增长，导通后压降变化很小。</string>
    <string name="feature_breakdown">反向击穿特性：反向电压超过击穿值时电流骤增，可用于稳压，也需避免损坏。</string>
    <string name="feature_switch">高频与开关特性：肖特基、快恢复二极管反向恢复时间短，适合高频电路。</string>
    <string name="section_types">常见类型</string>
    <string name="type_silicon_title">硅整流二极管</string>
    <string name="type_silicon_note">1N4007 · 通用整流</string>
    <string name="type_schottky_title">肖特基二极管</string>
    <string name="type_schottky_note">1N5819 · 低压降</string>
    <string name="type_zener_title">稳压二极管</string>
    <string name="type_zener_note">1N4733 · 反向稳压</string>
    <string name="type_led_title">发光二极管</string>
    <string name="type_led_note">LED · 电致发光</string>
    <string name="section_symbol">符号识读</string>
    <string name="symbol_text">三角形指向阴极 K，箭头方向即正向电流方向；竖线一端为阴极（负极），另一端为阳极 A（正极）。</string>
    <string name="action_open_parameters">查看参数参考值</string>
    <string name="intro_footnote">以上内容为教学演示用的通用描述，具体参数请以器件手册为准。</string>

    <!-- 参数页 -->
    <string name="parameter_heading">二极管关键参数参考值</string>
    <string name="parameter_subtitle">常用二极管的正向压降与最大整流电流参考值，实际数值随型号、温度与工作电流变化。</string>
    <string name="parameter_summary_voltage_value">0.7 V</string>
    <string name="parameter_summary_voltage_label">正向压降 V_F</string>
    <string name="parameter_summary_voltage_note">硅管典型值</string>
    <string name="parameter_summary_current_value">1 A</string>
    <string name="parameter_summary_current_label">最大整流电流 I_F</string>
    <string name="parameter_summary_current_note">1N4007 参考值</string>
    <string name="section_forward_voltage">正向压降 V_F</string>
    <string name="section_forward_voltage_desc">正向导通时阳极与阴极之间的电压差，是估算功耗与压降的关键参数。</string>
    <string name="section_max_current">最大整流电流 I_F(max)</string>
    <string name="section_max_current_desc">允许长期通过的最大平均整流电流，选型时应留出 30%% ~ 50%% 余量。</string>
    <string name="parameter_tips_title">参考提示</string>
    <string name="parameter_tip_1">正向压降随正向电流增大和温度升高而变化，大电流时可达 1 V 以上。</string>
    <string name="parameter_tip_2">最大整流电流指电阻性负载下的平均电流，容性负载需降额使用。</string>
    <string name="parameter_tip_3">本页数据为常见器件的典型参考值，设计与维修时请查阅具体型号手册。</string>
    <string name="parameter_footnote">单位说明：V 为伏特，A 为安培，mA 为毫安（1 A = 1000 mA）。</string>
