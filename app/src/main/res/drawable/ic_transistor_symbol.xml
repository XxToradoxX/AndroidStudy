    android:height="120dp"
    android:viewportWidth="240"
    android:viewportHeight="120">

    <!-- 符号外圈柔光 -->
    <path
        android:fillColor="#228AB4F8"
        android:pathData="M120,10 A50,50 0 1,1 119.9,10 Z" />

    <!-- 外圈描边 -->
