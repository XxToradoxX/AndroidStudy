    <path
        android:fillColor="#FFFFFF"
        android:pathData="M92,30 L100,30 L100,90 L92,90 Z" />

    <!-- 集电极引线（右上 C） -->
    <path
        android:pathData="M96,46 L152,22 L200,22"
        android:strokeWidth="6"
        android:strokeColor="#8AB4F8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 发射极引线（右下 E） -->
    <path
        android:pathData="M96,74 L152,98 L200,98"
        android:strokeWidth="6"
        android:strokeColor="#8AB4F8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- NPN 箭头：沿发射极引线指向外 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M147,92 L129,76 L136,96 Z" />
